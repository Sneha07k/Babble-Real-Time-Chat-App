# copy to .env and fill in real values (never commit .env)
MONGO_URI=
JWT_SECRET=
GROQ_API_KEY=
# optional: defaults to openai/gpt-oss-20b
GROQ_MODEL=
PORT=5000
# URL the React app is served from in development (socket.io CORS)
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# Google sign-in: OAuth "Web application" client id from Google Cloud Console.
# Must match REACT_APP_GOOGLE_CLIENT_ID in frontend/.env
GOOGLE_CLIENT_ID=

# Email for OTP codes. Leave empty in development and codes are printed
# in the server console instead. Required in production.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, and an App Password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Babble <no-reply@example.com>

# Cloudinary account for photos, videos and voice notes (optional; defaults to the current one)
# must match VITE_CLOUDINARY_CLOUD_NAME in frontend/.env
CLOUDINARY_CLOUD_NAME=
